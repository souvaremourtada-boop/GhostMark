{
  "manifest_version": 3,
  "name": "GhostMark Verifier",
  "version": "1.0.0",
  "description": "Vérifiez l'authenticité des documents GhostMark directement depuis votre navigateur.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GhostMark — Vérifier un document"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
